# Copy to .env and adjust if needed: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=kidsvocab
POSTGRES_USER=kidsvocab
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Host ports ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Security (JWT authentication) ---
# Random string of at least 32 bytes, e.g.: openssl rand -base64 48
JWT_SECRET=

# --- AI word suggestion provider ---
# none              : local dictionary only
# gemini            : Google AI Studio key (https://aistudio.google.com/apikey)
# openai-compatible : Groq by default (https://console.groq.com/keys); set AI_BASE_URL for OpenRouter/Mistral
AI_PROVIDER=none
AI_API_KEY=
# Optional overrides; empty = provider default
AI_BASE_URL=
AI_MODEL=
